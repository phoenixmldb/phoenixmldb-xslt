<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <!-- Release-gate probe (xslt#237): runs one transformation on the browser-wasm runtime under
       Node. Built by scripts/release-gate.sh in a scratch copy, against either a published
       package (XsltVersion) or this repo's engine source (XsltProject). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup Condition="'$(XsltProject)' == ''">
    <PackageReference Include="PhoenixmlDb.Xslt" Version="$(XsltVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(XsltProject)' != ''">
    <ProjectReference Include="$(XsltProject)" SetTargetFramework="TargetFramework=net10.0" />
  </ItemGroup>
</Project>
